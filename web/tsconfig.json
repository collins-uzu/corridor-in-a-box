{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "ES2022"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    // Next 16 requires the React automatic runtime; "preserve" is rewritten on
    // every build, so it is set here rather than left for next build to patch.
    "jsx": "react-jsx",
    "isolatedModules": true,
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./*"],
      "@corridor/engine": ["../packages/engine/src/index.ts"],
      "@corridor/adapter-kit": ["../packages/adapter-kit/src/index.ts"],
      "@corridor/manifest": ["../packages/manifest/src/index.ts"],
      "@corridor/router": ["../packages/router/src/index.ts"],
      "@corridor/types": ["../packages/types/src/index.ts"]
    }
  },
  // .next/dev/types is where Next 16 emits its generated route types.
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
